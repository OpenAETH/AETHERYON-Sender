# ─── AUTH ─────────────────────────────────────
APP_USER=admin
APP_PASSWORD=tu_password_seguro
SECRET_KEY=genera_con__python_-c_"import secrets; print(secrets.token_hex(32))"
TOKEN_TTL_HOURS=8

# ─── DATABASE (Supabase) ───────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── SUPABASE STORAGE (adjuntos) ──────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=service_role_key_de_tu_proyecto
STORAGE_BUCKET=email_attachments

# ─── RESEND (envío de emails) ─────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_NAME=Nombre Remitente

# ─── IMAP (bandeja de entrada) ────────────────
IMAP_HOST=mail.tudominio.com
IMAP_PORT=993
IMAP_USER=contacto@tudominio.com
IMAP_PASS=tu_password_imap

# ─── GROQ (generación de campañas IA) ─────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMTP (no usado en producción — Resend reemplaza el envío) ───
# Dejar vacío o eliminar. Se conservan por compatibilidad con deploys legacy.
SMTP_METHOD=smtp_ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
