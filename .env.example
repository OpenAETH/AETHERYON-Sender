# ─── AUTH ─────────────────────────────────────
APP_USER=admin
APP_PASSWORD=tu_password_seguro
SECRET_KEY=genera_con__python_-c_"import secrets; print(secrets.token_hex(32))"
TOKEN_TTL_HOURS=8

# ─── DATABASE (Supabase/Postgres — persistencia EXCLUSIVA, sin SQLite) ──
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── SUPABASE STORAGE (adjuntos) ──────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...  # service_role key (JWT) de Supabase Settings > API.
                              # NO usar publishable key ni sb_secret_.
STORAGE_BUCKET=email_attachments

# ─── RESEND (proveedor de envío) ──────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=contacto@tudominio.com
SENDER_NAME=Nombre Remitente

# ─── IMAP (bandeja de entrada, componente secundario) ──
IMAP_HOST=mail.tudominio.com
IMAP_PORT=993
IMAP_USER=contacto@tudominio.com
IMAP_PASS=tu_password_imap

# ─── GROQ (asistencia opcional de redacción) ──
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CRON SENDER (límites y cadencia del scheduler) ──
SENDER_RATE_LIMIT_PER_RUN=50
SENDER_MAX_ATTEMPTS=3
SENDER_RETRY_BACKOFF_MINUTES=30
SCHEDULER_INTERVAL_SECONDS=60
